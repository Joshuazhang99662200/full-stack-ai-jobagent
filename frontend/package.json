{
  "name": "@jobagent/polling-console",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/Console.d.ts",
      "import": "./lib/console.js"
    },
    "./styles.css": "./lib/console.css",
    "./muse": {
      "types": "./lib/muse/index.d.ts",
      "import": "./muse-lib/muse.js"
    },
    "./muse/styles.css": "./muse-lib/muse.css"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/@playwright/test/cli.js test",
    "test:ssr": "node scripts/ssr-smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
